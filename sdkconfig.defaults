# espix — target-independent defaults.
# Per-target settings live in sdkconfig.defaults.<target>.

#
# Partition table. The layout itself is per-target and per-board, so the
# filename is set in sdkconfig.defaults.<target> and overridden by boards/.
#
CONFIG_PARTITION_TABLE_CUSTOM=y

#
# FreeRTOS — needed for `ps` / `top` style introspection.
#
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# One TLS slot is reserved for the per-task espix session pointer
# (see espix_shell_set_current / espix_shell_current).
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=3

#
# Main task — app_main runs the boot sequence and then the console session.
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

#
# Post-mortem
#
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

#
# ELF loader (espressif/elf_loader) — the centerpiece: load native apps
# cross-compiled on a PC off the filesystem at runtime.
#
CONFIG_ELF_LOADER=y
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
CONFIG_ELF_FILE_SYSTEM_BASE_PATH="/bin"
CONFIG_ELF_LOADER_LIBC_SYMBOLS=y
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=y

#
# Memory protection must be off for the ELF loader to work: it writes a
# relocated image into memory and then executes it, which is exactly what the
# PMS/PMP feature exists to prevent. Espressif's own elf_loader examples set
# this. It is also, bluntly, part of why apps are not isolated from the kernel.
#
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

#
# LittleFS — mounted as the root filesystem. LITTLEFS_OBJ_NAME_LEN must match
# the --name-max used by littlefs_create_partition_image().
#
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
# Needed by elf_loader's dlopen(), which resolves an open fd back to its path.
CONFIG_LITTLEFS_FCNTL_GET_PATH=y
CONFIG_LITTLEFS_OPEN_DIR=y

#
# libc — pinned to newlib rather than IDF 6.1's new picolibc default.
#
# Two reasons: (1) under picolibc stdin/stdout are thread-local and linenoise
# needs the TLS-stdio shim in components/console/private_include, which we
# cannot include from outside that component; (2) elf_loader's libc symbol
# table — how loaded apps resolve printf() and friends against the firmware —
# is written against newlib.
#
CONFIG_LIBC_NEWLIB=y

#
# Networking. WiFi keeps calibration and its own state in NVS, which is what
# finally uses the nvs partition reserved in partitions.csv.
#
CONFIG_ESP_WIFI_NVS_ENABLED=y
# Backstop only. espix sets the hostname on every netif it creates (lwip stores
# it per-interface), so this is what a netif created outside our path would
# report. Kept in sync with the generated <target>-<mac> form for consistency.
CONFIG_LWIP_LOCAL_HOSTNAME="espix"

# One socket per SSH connection, plus the listener, plus whatever DHCP and SNTP
# hold. ESP-IDF's default of 10 was enough while the SSH server accepted four
# connections; at CONFIG_ESPIX_SSH_MAX_SESSIONS=8 it is not, and the failure
# would be an accept() that returns EMFILE rather than anything naming sockets.
#
# This is also FD_SETSIZE, which is why select() in the console and the SSH
# server keep working as it rises, and why espix's device fds sit at 240-255
# (see espix_fs/dev.c) -- far above anything lwIP will hand out.
CONFIG_LWIP_MAX_SOCKETS=20

#
# Execute from PSRAM instead of flash.
#
# Not a performance option, though it turns out to be one. It closes a crash.
#
# A flash write or erase forces ESP-IDF to disable the flash cache -- you cannot
# fetch instructions through a cache backed by a chip that is mid-erase. Inside
# that window, cache maintenance faults: Cache_WriteBack_Addr is manipulating a
# cache being switched off underneath it, and the CPU takes exccause 0x47,
# CacheError.
#
# espix walks into that window constantly. With the SSH connection state in
# PSRAM, IDF's AES and SHA drivers call esp_cache_msync() on every packet they
# encrypt or authenticate -- and espix reads and writes flash from other tasks
# all the time, because that is what a filesystem is. Running four test suites
# at once panicked the board this way about one run in three, in
# Cache_WriteBack_Addr under both esp_aes_process_dma() and esp_sha_dma_process().
#
# With .text and .rodata copied into PSRAM at boot, a flash operation no longer
# has to disable the cache, and the window closes. ESP-IDF documents exactly
# this exception: "if XIP_From_PSRAM is enabled, you can call this API during
# Flash operations."
#
# Measured on an N16R8. PSRAM total falls from 8189K to 7114K -- 1075K for the
# image, out of eight megabytes. Internal RAM is unchanged at 145K free. scp
# throughput *rose*, 562 -> 612 KB/s up and 476 -> 594 KB/s down, because flash
# operations no longer stall the core. The seed that had just panicked ran 147
# assertions green.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

#
# Console
#
CONFIG_VFS_SUPPORT_DIR=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Leave the compile-time maximum at INFO. Raising it to DEBUG does not just
# allow debug output at runtime — espcoredump's macros gate on LOG_LOCAL_LEVEL
# at compile time and write straight to esp_rom_printf, bypassing the runtime
# level entirely, so a DEBUG maximum buries every crash under a page of
# core-dump tracing. It also links in all those format strings.

#
# System time
#
# Take the NTP server from the DHCP lease (option 42), the way a Linux DHCP
# client does. A network with a local time server but no route to the internet
# then still gets the right time, and one without simply falls through to the
# pool. Off by default in ESP-IDF.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# Two servers, not one: DHCP's answer takes slot 0 and espix re-registers its
# own fallback at slot 1, so a DHCP-supplied server never displaces the pool
# entirely. With one slot the fallback would be silently overwritten.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

#
# USB-NCM (usb0)
#
# NCM rather than ECM or RNDIS. All three carry Ethernet over USB; NCM is the
# modern one and the only one every current host takes without help -- Linux,
# macOS and Windows 11 all bind it from their own in-box drivers. ECM has never
# worked on Windows without a third-party .inf, and RNDIS is the mirror image,
# Microsoft's own protocol that Linux supports and macOS does not. NCM is also
# the efficient one: it packs several Ethernet frames into one USB transfer
# (the NTB below), where ECM sends one frame per transfer.
CONFIG_TINYUSB_NET_MODE_NCM=y

# NTB buffers: how many aggregate blocks are in flight each way, and how large
# each may be. Three of 3200 bytes each way is Espressif's own recommendation
# for NCM and costs about 19KB.
#
# The count is what stops "tud_network_can_xmit: request blocked" under load: a
# single buffer each way means the link stalls whenever the host has not yet
# collected the last block. espix drops a frame it cannot hand to TinyUSB and
# lets TCP retransmit, which is correct but slow if it happens often.
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=3200
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=3200

# What the computer calls this thing. Without these it enumerates as "Espressif
# Systems / Espressif Device", which is what every unconfigured TinyUSB project
# on the machine also calls itself.
#
# The serial string stays at TinyUSB's default and is the same on every board,
# which is worth knowing: two espix devices on one computer are told apart by
# their MAC, which is derived per chip, and not by this. Making it per-device
# means supplying string descriptors at runtime rather than from Kconfig.
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="espix"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="espix USB Ethernet"

#
# espix
#
# The Kconfig default is 8 as well; repeating it here is what makes a fresh
# checkout build with it, since sdkconfig is not tracked and an existing one
# would otherwise keep whatever it already had. Neither of these overrides an
# sdkconfig that already names the option -- delete it, or edit it by hand.
CONFIG_ESPIX_SSH_MAX_SESSIONS=8
