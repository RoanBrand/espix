# espix — target-independent defaults.
# Per-target settings live in sdkconfig.defaults.<target>.

#
# Partition table. The layout itself is per-target and per-board, so the
# filename is set in sdkconfig.defaults.<target> and overridden by boards/.
#
CONFIG_PARTITION_TABLE_CUSTOM=y

#
# Application rollback. With two OTA slots the bootloader can revert to the
# previous image when a freshly-written one does not confirm itself on its first
# boot -- one attempt, no retry counter. espix confirms from app_main once the
# console is up; see docs/OTA.md.
#
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

#
# A/B firmware updates: the `upgrade` command. On by default for 16MB because
# that table has ota_0/ota_1; the 8MB factory table has no second slot, so the
# Kconfig default turns it off there. See docs/OTA.md.
#
CONFIG_ESPIX_OTA_ENABLED=y

#
# FreeRTOS — needed for `ps` / `top` style introspection.
#
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# One TLS slot is reserved for the per-task espix session pointer
# (see espix_shell_set_current / espix_shell_current).
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=3

#
# Main task — app_main runs the boot sequence and then the console session.
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

#
# Post-mortem
#
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# A dump carries task stacks only, not .bss or .data.
#
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y would add them, and it does not fit: IDF
# asks for at least 128KB of coredump partition and ours is 64KB
# (partitions/esp32s3-16mb.csv). Growing it means moving `storage`, which means
# reflashing the whole filesystem -- so this is a real decision, not an
# oversight, and the consequence is that a dump cannot tell you the value of a
# static. Reach for a watchpoint instead: it stops at the instruction, which is
# better evidence than the wreckage afterwards.

#
# Heap corruption hunting — off, and here is the switch when it is needed.
#
# Uncomment to make every allocation carry head and tail canaries, checked on
# free, with freed memory filled and verified on the next allocation. It catches
# an overrun at the block that overran and a double free on the spot, instead of
# leaving TLSF to trip over the damage minutes later in whatever task happens to
# free next. docs/KNOWN-ISSUES.md has the open PSRAM corruption this exists for.
#
# CONFIG_HEAP_POISONING_COMPREHENSIVE=y
#
# Two things to know before switching it on. It costs speed — every alloc and
# free memsets, so throughput drops and task watchdog warnings get commoner, and
# neither is a regression. And it costs internal RAM: the per-block canaries were
# enough to drive `min free internal since boot` to 0 K at eight concurrent
# sessions, which fails assertions in ways that read as unrelated bugs.
#
# Put it here rather than in `sdkconfig`, which is gitignored and regenerated
# from this file: an experiment kept only there is silently reverted by
# `idf.py fullclean`, and a clean run from a quietly uninstrumented build is
# worse than no run at all. `free` on the device reports which way it is set, so
# a build can always be asked rather than assumed.
#
# Switching it off again is NOT symmetric, and this cost a build. Adding a line
# here overrides `sdkconfig` when the value there is still at its Kconfig
# default; *removing* the line does not, because by then `sdkconfig` holds it as
# an explicit setting and an existing `sdkconfig` wins. So turning it off means
# editing `sdkconfig` too (or deleting it and letting this file regenerate it).
# Check `build/config/sdkconfig.h` afterwards rather than assuming either way.
#
# The same asymmetry crosses *branches*, which is worse, because nothing about
# the working tree shows it. `sdkconfig` is gitignored, so it is not switched
# with the branch: build a branch that sets an option, check out another, and
# every later build carries that option with no sign of it in `git status`.
#
# That cost half a day. A `/dev` feature branch set
# CONFIG_VFS_INITIALIZE_DEV_NULL=n; `main` was then built with that config and
# without the branch's matching code, which broke /dev/null for non-root users
# and was recorded in KNOWN-ISSUES.md as a bug in espix. It was not.
#
# The stale-firmware guard does not catch this: it compares the board against
# `build/`, and those two agree perfectly. What disagrees is `build/` and the
# source. When a config-dependent result surprises you, check
# `build/config/sdkconfig.h` against this file before believing it.

#
# ELF loader (espressif/elf_loader) — the centerpiece: load native apps
# cross-compiled on a PC off the filesystem at runtime.
#
CONFIG_ELF_LOADER=y
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
CONFIG_ELF_FILE_SYSTEM_BASE_PATH="/bin"
CONFIG_ELF_LOADER_LIBC_SYMBOLS=y
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=y

#
# Memory protection must be off for the ELF loader to work: it writes a
# relocated image into memory and then executes it, which is exactly what the
# PMS/PMP feature exists to prevent. Espressif's own elf_loader examples set
# this. It is also, bluntly, part of why apps are not isolated from the kernel.
#
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

#
# LittleFS — mounted as the root filesystem. LITTLEFS_OBJ_NAME_LEN must match
# the --name-max used by littlefs_create_partition_image().
#
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
# Needed by elf_loader's dlopen(), which resolves an open fd back to its path.
CONFIG_LITTLEFS_FCNTL_GET_PATH=y
CONFIG_LITTLEFS_OPEN_DIR=y

#
# libc — pinned to newlib rather than IDF 6.1's new picolibc default.
#
# Two reasons: (1) under picolibc stdin/stdout are thread-local and linenoise
# needs the TLS-stdio shim in components/console/private_include, which we
# cannot include from outside that component; (2) elf_loader's libc symbol
# table — how loaded apps resolve printf() and friends against the firmware —
# is written against newlib.
#
CONFIG_LIBC_NEWLIB=y

#
# Networking. WiFi keeps calibration and its own state in NVS, which is what
# finally uses the nvs partition reserved in partitions.csv.
#
CONFIG_ESP_WIFI_NVS_ENABLED=y
# Backstop only. espix sets the hostname on every netif it creates (lwip stores
# it per-interface), so this is what a netif created outside our path would
# report. Kept in sync with the generated <target>-<mac> form for consistency.
CONFIG_LWIP_LOCAL_HOSTNAME="espix"

# One socket per SSH connection, plus the listener, plus whatever DHCP and SNTP
# hold. ESP-IDF's default of 10 was enough while the SSH server accepted four
# connections; at CONFIG_ESPIX_SSH_MAX_SESSIONS=8 it is not, and the failure
# would be an accept() that returns EMFILE rather than anything naming sockets.
#
# This is also FD_SETSIZE, which is why select() in the console and the SSH
# server keep working as it rises. It is also the whole VFS fd table: IDF's
# vfs.h says `#define MAX_FDS FD_SETSIZE`, so this number is how many fds exist,
# period -- stdio, sockets and every open file together.
#
# Which is why it is 40 now rather than 20. espix's file fds used to be the
# filesystems' own numbers, so they never touched this table and 20 was purely a
# socket budget; they are registered fds now (see the comment on s_fds in
# espix_fs/vfs.c), because two filesystems both counting from zero cannot share
# one fd space. A path-based open on that route costs two entries -- IDF's, and
# the one espix allocates -- so 40 is headroom rather than a tight fit: eight
# SSH sessions' sockets plus a couple of dozen open files at once.
#
# The exhaustion that prompted the raise was *not* the number, though. espix's
# entry was registered non-permanent, and esp_vfs_unregister_fd() refuses
# anything that is not permanent (vfs.c:679), so it was never released: a boot's
# worth of opens filled the table and every open after that answered ENFILE.
# See fd_slot_alloc()/fd_slot_free() in espix_fs/vfs.c.
#
# espix's device fds sit at 240-255 (see espix_fs/dev.c), far above anything
# this table hands out, and are never registered here.
CONFIG_LWIP_MAX_SOCKETS=40

#
# Execute from PSRAM instead of flash.
#
# Not a performance option, though it turns out to be one. It closes a crash.
#
# A flash write or erase forces ESP-IDF to disable the flash cache -- you cannot
# fetch instructions through a cache backed by a chip that is mid-erase. Inside
# that window, cache maintenance faults: Cache_WriteBack_Addr is manipulating a
# cache being switched off underneath it, and the CPU takes exccause 0x47,
# CacheError.
#
# espix walks into that window constantly. With the SSH connection state in
# PSRAM, IDF's AES and SHA drivers call esp_cache_msync() on every packet they
# encrypt or authenticate -- and espix reads and writes flash from other tasks
# all the time, because that is what a filesystem is. Running four test suites
# at once panicked the board this way about one run in three, in
# Cache_WriteBack_Addr under both esp_aes_process_dma() and esp_sha_dma_process().
#
# With .text and .rodata copied into PSRAM at boot, a flash operation no longer
# has to disable the cache, and the window closes. ESP-IDF documents exactly
# this exception: "if XIP_From_PSRAM is enabled, you can call this API during
# Flash operations."
#
# Measured on an N16R8. PSRAM total falls from 8189K to 7114K -- 1075K for the
# image, out of eight megabytes. Internal RAM is unchanged at 145K free. scp
# throughput *rose*, 562 -> 612 KB/s up and 476 -> 594 KB/s down, because flash
# operations no longer stall the core. The seed that had just panicked ran 147
# assertions green.
#
# Boot cost is 88ms of the 836ms to user code: 17ms copying rodata and 71ms
# copying instructions, per the mmu_psram lines in the boot log. For scale,
# CONFIG_SPIRAM_MEMTEST in the same log costs 376ms.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

#
# Console
#
CONFIG_VFS_SUPPORT_DIR=y
# ESP-IDF registers its own nullfs VFS at "/dev/null" by default (nullfs.c,
# CONFIG_VFS_INITIALIZE_DEV_NULL). That prefix is longer than espix's "", so
# ESP-IDF routes /dev/null to it before espix sees the path, shadowing espix's
# own /dev/null node and bypassing the permission check. espix owns the whole of
# /dev, so IDF's copy must not be registered.
CONFIG_VFS_INITIALIZE_DEV_NULL=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Leave the compile-time maximum at INFO. Raising it to DEBUG does not just
# allow debug output at runtime — espcoredump's macros gate on LOG_LOCAL_LEVEL
# at compile time and write straight to esp_rom_printf, bypassing the runtime
# level entirely, so a DEBUG maximum buries every crash under a page of
# core-dump tracing. It also links in all those format strings.

#
# System time
#
# Take the NTP server from the DHCP lease (option 42), the way a Linux DHCP
# client does. A network with a local time server but no route to the internet
# then still gets the right time, and one without simply falls through to the
# pool. Off by default in ESP-IDF.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# Two servers, not one: DHCP's answer takes slot 0 and espix re-registers its
# own fallback at slot 1, so a DHCP-supplied server never displaces the pool
# entirely. With one slot the fallback would be silently overwritten.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

#
# USB-NCM (usb0)
#
# The role choice, in components/espix_net/Kconfig, decides whether any of this
# is built at all: USB-NCM and USB host claim the same OTG peripheral, and the
# S3 has one (SOC_USB_OTG_PERIPH_NUM is 1). These settings are inert in a
# host-role build, which is the default -- TinyUSB is not linked and nothing here
# is read.
#
# NCM rather than ECM or RNDIS. All three carry Ethernet over USB; NCM is the
# modern one and the only one every current host takes without help -- Linux,
# macOS and Windows 11 all bind it from their own in-box drivers. ECM has never
# worked on Windows without a third-party .inf, and RNDIS is the mirror image,
# Microsoft's own protocol that Linux supports and macOS does not. NCM is also
# the efficient one: it packs several Ethernet frames into one USB transfer
# (the NTB below), where ECM sends one frame per transfer.
CONFIG_TINYUSB_NET_MODE_NCM=y

# NTB buffers: how many aggregate blocks are in flight each way, and how large.
# A static array in TinyUSB (ncm_epbuf); DRAM_ATTR keeps it out of .bss, so the
# size is paid twice -- internal RAM and flash.
#
# The counts are deliberately asymmetric, and it took measuring to find out why.
# Three runs of 45-throughput over usb0 at each setting, KB/s:
#
#                        upload          download
#   OUT=3 IN=3      673 735 731      818 822 813     Espressif's default
#   OUT=2 IN=2      671 668 679       46  46  46     and truncated at 2MB
#   OUT=2 IN=3      673 737 743      839 785 847     kept
#
# So the receive buffer was spare and the transmit buffer is load-bearing.
# OUT=2 saves 3200 bytes (19,216 -> 16,016) and costs nothing measurable.
#
# IN=2 is not a slowdown, it is a breakage: scp of a 4MB file delivered exactly
# 2MB and stopped, at 46 KB/s, identically across three runs, with nothing in
# dmesg -- no "Packet cannot be accepted on USB interface". Kconfig accepts 1-6,
# so 2 is a legal value that silently loses data. See docs/UPSTREAM.md. Leave
# IN at 3.
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=2
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=3200
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=3200

# What the computer calls this thing. Without these it enumerates as "Espressif
# Systems / Espressif Device", which is what every unconfigured TinyUSB project
# on the machine also calls itself.
#
# The serial string stays at TinyUSB's default and is the same on every board,
# which is worth knowing: two espix devices on one computer are told apart by
# their MAC, which is derived per chip, and not by this. Making it per-device
# means supplying string descriptors at runtime rather than from Kconfig.
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="espix"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="espix USB Ethernet"

#
# USB host
#
# Hub support defaults to **n** in the host stack, so without this line a hub is
# a dead socket: the devices behind it never enumerate, and nothing in the log
# says why the stick is not there. This one line is what makes the hub half of
# the feature work. Multi-level hubs (a hub behind a hub) already default on.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# DEBUG has to be *compiled in* before a tag can be raised to it at runtime, and
# the USB stack logs almost everything at DEBUG -- a successful enumeration
# prints nothing at INFO at all. With this at IDF's default of INFO, "no output"
# means nothing: the messages do not exist in the image. The runtime level stays
# INFO, so nothing gets noisier unless a tag is raised (ESPIX_USB_VERBOSE, below).
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM is not set here, and cannot be: its
# Kconfig says `depends on IDF_TARGET_ESP32P4 && SPIRAM`, because only the P4's
# USB-DWC internal DMA can reach external RAM. On the S3 every USB buffer has to
# be internal, which is why the reads in espix_usb/host.c ask for MALLOC_CAP_DMA
# rather than taking the cheapest heap. On a P4 board this is the line to add,
# and it is worth adding there: it moves the DMA buffers off the scarce heap.

#
# espix
#
# The Kconfig default is 8 as well; repeating it here is what makes a fresh
# checkout build with it, since sdkconfig is not tracked and an existing one
# would otherwise keep whatever it already had. Neither of these overrides an
# sdkconfig that already names the option -- delete it, or edit it by hand.
CONFIG_ESPIX_SSH_MAX_SESSIONS=8

# The connection task also runs commands that declare no stack of their own, so
# this is the protocol plus those. 6144 left too little: `lsusb` tripped the
# canary at 6368 bytes used. 8192 covers the protocol and the inline commands
# that do real work; anything deeper declares its own stack in the command
# table, where it costs one command instead of every session.
CONFIG_ESPIX_SSH_TASK_STACK=8192

# exFAT, for the 3.1TB exFAT partition a Samsung T9 carries. This is the one
# option here that is off for a reason other than a preference -- see
# components/espix_fs/Kconfig for what it patches in IDF and the licensing note
# that goes with it -- so a build that wants it says so explicitly.
CONFIG_ESPIX_FS_EXFAT=y

# ext2/3/4, via the vendored esp_lwext4 component. The feature set has to be
# ext4 for a real Linux volume — an ext4 filesystem carries the `extents`
# incompatible feature, so the ext3 set would not accept it. Everything else the
# component needs (the MIT extents implementation, journaling, the internal-SRAM
# allocator) is already its default.
CONFIG_LWEXT4_FEATURE_SET_EXT4=y

# The driver that uses it. Off in the Kconfig, on here, like exFAT above: it is
# the third filesystem and the point of bringing lwext4 in, so a build of this
# tree wants it, but a build that does not should not pay for the library.
CONFIG_ESPIX_FS_EXT4=y

# Precomputation for base-point scalar multiplication, which is what ECDSA does
# for k*G -- and signing the exchange hash with the nistp256 host key is the
# largest single cost in an SSH key exchange here. The ESP32-S3 has no ECC
# accelerator (no SOC_ECC_SUPPORTED), so this is all software with only the MPI
# peripheral assisting, and IDF leaves the option off to save memory.
#
# Measured on an N16R8: the ECDSA signature falls from 593ms to 319ms, taking
# the whole key exchange from 1060ms to 650ms. It costs about 1K of internal
# heap with eight sessions open -- 45K free against 44K without -- and ~22K of
# image, which under XIP lives in PSRAM rather than internal RAM.
#
# It does nothing for X25519, at ~140ms each way: mbedtls drives Curve25519
# through the generic ECP path, and the agreement half is a variable-point
# multiplication that no amount of base-point precomputation helps.
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
