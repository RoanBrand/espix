+/*
+ * ESPIX addition; the reasoning and the upstream difference are documented on
+ * the declaration in ext4_super.h.
+ *
+ * The kernel computes this once at mount and keeps it as s_csum_seed:
+ *
+ *	if (ext4_has_feature_csum_seed(sbi))
+ *		sbi->s_csum_seed = le32_to_cpu(es->s_checksum_seed);
+ *	else
+ *		sbi->s_csum_seed = ext4_chksum(sbi, ~0, es->s_uuid,
+ *					       sizeof(es->s_uuid));
+ *
+ * which is exactly this, so the checksum helpers seed the same way the
+ * filesystem was written without each of them carrying the branch.
+ */
+uint32_t ext4_sb_csum_seed(struct ext4_sblock *s)
+{
+	if (ext4_sb_feature_incom(s, EXT4_FINCOM_CSUM_SEED))
+		return ext4_get32(s, checksum_seed);
+
+	return ext4_crc32c(EXT4_CRC32_INIT, s->uuid, sizeof(s->uuid));
+}
