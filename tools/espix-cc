#!/usr/bin/env bash
#
# The C compiler for POSIX apps, as musl-gcc is for musl: the toolchain's gcc,
# picolibc's headers, and libespix as the OS layer under them. App source needs
# only standard headers. docs/USER-MODE.md.
#
#   tools/espix-cc -Os -o hello hello.c                       a U-mode app for the S31
#   tools/espix-cc --target=esp32s3 -Os -o hello hello.c      an app for the S3, without an MMU
#   tools/espix-cc -c foo.c
#   tools/espix-cc --strip hello hello.staged
#   tools/espix-cc --target=esp32s3 --build-lib                prints the path of libespix.a
#   tools/espix-cc --target=esp32s3 -static -o hello hello.c  libc linked in whole
#
# The S31's app is a static executable with picolibc linked in. An app without an
# MMU is a shared object the kernel's loader relocates: it links libc's state
# (libc-app.a) and binds the rest to the one /lib/libc.so every app shares.
#
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)

target=esp32s31
args=()
for a in "$@"; do
    case "$a" in
        --target=*) target=${a#--target=} ;;
        *)          args+=("$a") ;;
    esac
done
set -- ${args[@]+"${args[@]}"}

case "$target" in
    esp32s31) triple=riscv32-esp-elf; gname=riscv32-esp-elf-gcc; tool=riscv32-esp-elf- ;;
    esp32s3)  triple=xtensa-esp-elf;  gname=xtensa-esp32s3-elf-gcc; tool=xtensa-esp-elf- ;;
    *) echo "espix-cc: no target $target (esp32s31, esp32s3)" >&2; exit 1 ;;
esac

gcc=$(command -v "$gname" || true)
if [[ -z "$gcc" ]]; then
    gcc=$(ls -d "$HOME"/.espressif/tools/"$triple"/*/"$triple"/bin/"$gname" 2>/dev/null | tail -1)
fi
[[ -x "$gcc" ]] || { echo "espix-cc: no $gname" >&2; exit 1; }
bin=$(dirname "$gcc")
ar="$bin/${tool}ar"

incs=(-I"$root/user/include" -I"$root/user/include/common" -include "$root/cmake/offt64.h")
# picolibc's headers declare the pthread subset IDF implements; libespix implements barriers and spinlocks too.
posix=(-D_POSIX_BARRIERS=200112L -D_POSIX_SPIN_LOCKS=200112L -DESPIX_POSIX_APP=1)

if [[ $target == esp32s31 ]]; then
    # No PIE or hardware-loop extensions: only core 1 has them.
    # No cm.popret, as IDF builds the kernel: with it libespix's mutex deadlocked (docs/GOTCHAS.md).
    arch=(-march=rv32imafc_zicsr_zifencei_zaamo_zalrsc_zcb_zcmp_zcmt -mabi=ilp32f -mno-cm-popret)
    # off_t is 64 bits, as in the kernel and M-mode apps (cmake/offt64.h).
    cflags=(--specs=picolibc.specs -ffunction-sections -fdata-sections -DESPIX_UMODE_APP=1 "${posix[@]}" "${incs[@]}")
    lib="$root/user/build"
    skip=()
else
    # The app's own picolibc (tools/build-libc.sh): errno is a call, so it is the kernel's per thread.
    libc="$root/build-libc-$target"
    arch=(-mlongcalls)
    cflags=(-isystem "$libc/include"
            -ffunction-sections -fdata-sections -fPIC -fvisibility=hidden
            -fno-builtin-memcpy -fno-builtin-memset -fno-builtin-bzero
            -DESPIX_NOMMU_APP=1 "${posix[@]}" "${incs[@]}")
    lib="$root/user/build-$target"
    # The kernel's: the allocator, threads, signals, the screen and audio.
    skip=(start.c malloc.c pthread.c signal.c gfx.c audio.c)
fi

# libespix.a (and crt0.o for the S31), rebuilt when a source is newer; built aside and moved in, so parallel callers never see half.
build_lib() {
    if [[ $target == esp32s3 && ! -f "$libc/include/picolibc.h" ]]; then
        "$root/tools/build-libc.sh" "$target" >&2
    fi
    local srcs=("$root"/user/libespix/*.c "$root"/user/libespix/*.h "$root"/user/libespix/*.S "$root"/user/crt0.S
                "$root"/user/include "$root"/components/espix_proc/include/espix_syscall.h
                ${libc:+"$libc/include/picolibc.h"}
                "$root"/components/espix_proc/include/espix_gfx.h
                "$root"/components/espix_display/include/espix_display.h
                "$root"/components/espix_audio/include/espix_audio.h "$0")
    if [[ -f "$lib/libespix.a" && -z "$(find "${srcs[@]}" -newer "$lib/libespix.a" 2>/dev/null | head -1)" ]]; then
        return 0
    fi
    mkdir -p "$lib"
    local tmp
    tmp=$(mktemp -d "$lib/.build.XXXXXX")
    local f extra base
    for f in "$root"/user/libespix/*.c; do
        base=$(basename "$f")
        if [[ " ${skip[*]-} " == *" $base "* ]]; then
            continue
        fi
        extra=()
        # picolibc's own stdio and its lseek must see libc's 32-bit off_t.
        case "$base" in lseek32.c|start.c) extra=(-DESPIX_LIBC_OWN_OFF_T) ;; esac
        "$gcc" "${arch[@]}" "${cflags[@]}" ${extra[@]+"${extra[@]}"} -Os -Wall \
            -I"$root/components/espix_proc/include" -I"$root/components/espix_display/include" \
            -I"$root/components/espix_audio/include" -c "$f" -o "$tmp/${base%.c}.o"
    done
    if [[ $target == esp32s31 ]]; then
        for f in "$root"/user/libespix/*.S; do
            "$gcc" "${arch[@]}" -c "$f" -o "$tmp/$(basename "${f%.S}")_S.o"
        done
        "$gcc" "${arch[@]}" -c "$root/user/crt0.S" -o "$tmp/crt0.o"
        mv -f "$tmp/crt0.o" "$lib/crt0.o"
    fi
    (cd "$tmp" && "$ar" rcs libespix.a *.o)
    mv -f "$tmp/libespix.a" "$lib/libespix.a"
    rm -rf "$tmp"
}

# espix-cc --strip <in> <out>: a copy without debug info, for staging onto the board. The S3's
# loader reads only the dynamic symbols, so its copy loses the rest, and Xtensa's property tables.
if [[ ${1:-} == --strip ]]; then
    if [[ $target == esp32s3 ]]; then
        exec "$bin/${tool}strip" --strip-all -R .xt.prop -R .xt.lit -R .comment -R .xtensa.info -o "$3" "$2"
    fi
    exec "$bin/${tool}strip" --strip-debug -o "$3" "$2"
fi

# espix-cc --build-lib: build libespix.a (and crt0.o) only, and say where.
if [[ ${1:-} == --build-lib ]]; then
    build_lib
    echo "$lib/libespix.a"
    exit 0
fi

link=yes
static=no
args=()
for a in "$@"; do
    case "$a" in
        -c|-S|-E|-M|-MM) link=no; args+=("$a") ;;
        -static)         static=yes ;;
        *)               args+=("$a") ;;
    esac
done
set -- ${args[@]+"${args[@]}"}

if [[ $link == no ]]; then
    exec "$gcc" "${arch[@]}" "${cflags[@]}" "$@"
fi

build_lib
if [[ $target == esp32s31 ]]; then
    # Whole and ahead of libc: libc.a's weak nosys stubs would otherwise win the archive scan.
    # The allocator wrapped, so large blocks are mappings (user/libespix/malloc.c).
    exec "$gcc" "${arch[@]}" "${cflags[@]}" "$@" \
        -nostartfiles -static -T "$root/user/uapp.ld" -Wl,--gc-sections \
        -Wl,--wrap=malloc,--wrap=free,--wrap=calloc,--wrap=realloc,--wrap=malloc_usable_size \
        "$lib/crt0.o" -Wl,--whole-archive "$lib/libespix.a" -Wl,--no-whole-archive
fi
# A shared object for the loader: libc's state and allocation in the app, the rest from /lib/libc.so
# (or all of libc in the app, -static), and the note naming which. What is left, the kernel answers.
"$root/tools/build-libc.sh" "$target" >/dev/null
split="$libc/split"
if [[ $static == yes ]]; then
    libs=("$libc/lib/libc.a"); note="$split/abi-note-static.o"
else
    libs=("$split/libc-app.a"); note="$split/abi-note.o"
fi
exec "$gcc" "${arch[@]}" "${cflags[@]}" "$@" \
    -nostartfiles -nostdlib -shared -e __espix_main -Wl,--gc-sections -Wl,--exclude-libs,ALL \
    -Wl,--start-group "$lib/libespix.a" "${libs[@]}" -Wl,--end-group "$note"
