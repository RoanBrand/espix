-/* netif data index to get the bridge on input */
-static u8_t bridgeif_netif_client_id = 0xff;
+/* Every bridge, so a port finds its own without a client-data slot
+ * (tools/patch-lwip.py). Bridges are never freed. */
+static bridgeif_private_t *bridgeif_list;
 
+static bridgeif_port_t *
+bridgeif_port_of(struct netif *portif)
+{
+  bridgeif_private_t *br;
+  u8_t i;
+  for (br = bridgeif_list; br != NULL; br = br->next) {
+    for (i = 0; i < br->num_ports; i++) {
+      if (br->ports[i].port_netif == portif) {
+        return &br->ports[i];
+      }
+    }
+  }
+  return NULL;
+}
