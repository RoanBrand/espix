# ESP-IDF build output
build/
sdkconfig
sdkconfig.old
managed_components/

# Cross-compiled apps under apps/ are separate IDF projects
apps/*/build/
apps/*/sdkconfig
apps/*/sdkconfig.old
apps/*/managed_components/

# Apps staged into the rootfs image are build artifacts, not source.
# Build them from apps/ and copy them in — see tools/README.md.
fsroot/bin/*
!fsroot/bin/.keep

# Editors / tooling
.DS_Store
.cache/
.vscode/
.continue/
compile_commands.json

# Personal design notes, not part of the project
PLAN.md

# NOTE: dependencies.lock IS committed, deliberately — it pins the exact
# component versions so builds are reproducible.
