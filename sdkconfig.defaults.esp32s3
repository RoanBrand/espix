# espix — ESP32-S3 with 16MB flash and 8MB octal PSRAM (N16R8 modules),
# e.g. the ESP32-S3-DevKitC-1 v1.1. This is the default and the only variant
# espix has actually been run on.
#
# Other modules are selected by adding a file from boards/ to
# SDKCONFIG_DEFAULTS, which lands after this one and overrides it — see the
# Building section of the README.

CONFIG_IDF_TARGET="esp32s3"

#
# Flash
#
# The build targets the largest flash espix supports (16 MB), so the flash is
# addressable to the top; the image itself is flashed with the smallest table
# (8 MB), which is valid on any larger chip, and the loader writes the table for
# the physical flash it finds. One image then runs on 8 and 16 MB.
# See docs/OTA.md section 11.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/esp32s3-8mb.csv"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

#
# PSRAM — apps get loaded here, so it is not optional on this target.
#
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESPIX_PSRAM_MB=8
CONFIG_SPIRAM_SPEED_80M=y

#
# The session task needs a little more here than the common default, and this is
# the one target where that was measured rather than guessed. Spawning an app
# runs on the session task -- the ELF is copied and relocated there -- and with
# the 8 KB default an S3 build panicked in sshd:conn loading Doom: "a stack
# overflow in task sshd:conn". With 16 KB the same load leaves 7956 bytes free,
# so it uses about 8.4 KB and 8 KB was short by a few hundred. 12 KB keeps ~1.8
# of margin for an app bigger than Doom's 343 KB. The S31 loads the same binary
# in 8 KB (its frames are smaller), so its file does not set this.
#
# The real fix is that the load should not be charged to whoever ran the
# command at all -- see the note in sdkconfig.defaults.
CONFIG_ESPIX_SSH_TASK_STACK=9216

#
# Load relocated ELF text/data into PSRAM rather than internal SRAM. On S3 this
# relies on the ibus/dbus address mirror (ELF_LOADER_BUS_ADDRESS_MIRROR, which
# the component selects automatically for this target).
#
# CONFIG_ELF_LOADER_LOAD_PSRAM is in sdkconfig.defaults; what is here is the
# mirror this target needs for it.

#
# CPU
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
