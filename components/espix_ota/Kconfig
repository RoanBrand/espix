menu "espix OTA"

    config ESPIX_OTA_ENABLED
        bool "Firmware updates over the network"
        default y if ESPTOOLPY_FLASHSIZE_16MB || ESPTOOLPY_FLASHSIZE_8MB
        default n
        help
            Compiles the `upgrade` command and the background update check.
            The partition table must have ota_0 (the kernel), ota_1 (the loader)
            and otadata, which both the 8MB and 16MB tables do. A build with
            this on and no loader slot refuses to update and says so.

    config ESPIX_OTA_AUTO_CHECK
        bool "Check for updates in the background"
        depends on ESPIX_OTA_ENABLED
        default y
        help
            A low-priority task checks at most once per
            ESPIX_OTA_CHECK_PERIOD_S, woken by the network getting an address,
            and never in the boot path. It never installs anything: the result
            only makes the greeting mention that an update exists.

    config ESPIX_OTA_CHECK_PERIOD_S
        int "Minimum seconds between background checks"
        depends on ESPIX_OTA_AUTO_CHECK
        range 3600 604800
        default 86400

    config ESPIX_OTA_ALLOW_HTTP
        bool "Allow plain-HTTP update sources (development)"
        depends on ESPIX_OTA_ENABLED
        default n
        select ESP_HTTPS_OTA_ALLOW_HTTP
        help
            Lets a development board pull from a laptop's HTTP server. Off by
            default: a release should fetch over TLS, and this is the one switch
            that makes the transport unauthenticated.

    config ESPIX_OTA_TIMEOUT_MS
        int "Network timeout (ms)"
        depends on ESPIX_OTA_ENABLED
        range 1000 300000
        default 30000

    config ESPIX_OTA_URL
        string "Default update manifest URL"
        depends on ESPIX_OTA_ENABLED
        default "https://github.com/RoanBrand/espix/releases/latest/download/espix-ota.json"
        help
            Where `upgrade` looks when /etc/espix.conf has no ota.url.

endmenu
