+/* espix patch 0003: only a verified NTLMv2 proof leaves a non-zero key */
+static int
+session_key_is_set(struct smb2_context *smb2)
+{
+        static const uint8_t zero_key[SMB2_KEY_SIZE];
+
+        return smb2->session_key != NULL &&
+               smb2->session_key_size >= SMB2_KEY_SIZE &&
+               memcmp(smb2->session_key, zero_key, SMB2_KEY_SIZE) != 0;
+}
+
+int
+smb2_session_is_authenticated(struct smb2_context *smb2)
+{
+        return smb2 != NULL && smb2->authenticated;
+}
