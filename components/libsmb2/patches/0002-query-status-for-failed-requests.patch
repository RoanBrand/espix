+/*
+ * espix patch 0002: name the NT status a failed request should carry. A
+ * handler's non-zero return otherwise means STATUS_NOT_IMPLEMENTED and nothing
+ * else, so a server cannot say that a file is missing.
+ */
+void smb2_set_error_status(struct smb2_context *smb2, uint32_t status);
+
 /*
  * Register an error callback, so any calls to smb2_set_error will call this
  * function with the error string generated
diff --git a/lib/libsmb2.c b/lib/libsmb2.c
index d2143e0..ef9242b 100644
--- a/lib/libsmb2.c
+++ b/lib/libsmb2.c
@@ -119,6 +119,30 @@
 #define DEFAULT_OUTPUT_BUFFER_LENGTH 0xffff
 #endif
 
+/*
+ * espix patch 0002. A server handler can only say "no": any non-zero return
+ * becomes STATUS_NOT_IMPLEMENTED, and a client that asked for a file which is
+ * not there needs STATUS_NO_SUCH_FILE to know that. smbd names a status with
+ * smb2_set_error_status() and the reply carries it; reading it clears it so
+ * one request cannot colour the next.
+ */
+static uint32_t
+take_error_status(struct smb2_context *smb2)
+{
+        const uint32_t status = smb2->error_status;
+
+        smb2->error_status = 0;
+        return status != 0 ? status : SMB2_STATUS_NOT_IMPLEMENTED;
+}
+
+void
+smb2_set_error_status(struct smb2_context *smb2, uint32_t status)
+{
+        if (smb2 != NULL) {
+                smb2->error_status = status;
+        }
+}
